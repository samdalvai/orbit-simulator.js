  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "gravity/__tests__/**/*",
    "gravity/demo/**/*",
    "benchmark/**/*",
    "benchmark copy/functions.ts"
, "main.ts"  ],

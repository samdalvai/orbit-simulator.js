{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "src_packed/**/*",
    "benchmark/**/*",
    "main.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}